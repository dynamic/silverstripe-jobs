{
    "name": "dynamic/silverstripe-jobs",
    "description": "Post open positions and receive online applications",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe"
    ],
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "require": {
        "silverstripe/lumberjack": "^4",
        "silverstripe/recipe-cms": "^6",
        "silverstripe/vendor-plugin": "^3",
        "symbiote/silverstripe-gridfieldextensions": "^4"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dynamic\\Jobs\\": "src/",
            "Dynamic\\Jobs\\Test\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 600
    },
    "extra": {
        "expose": [
            "javascript"
        ],
        "branch-alias": {
            "dev-4": "4.x-dev"
        }
    },
    "suggest": {
        "hudhaifas/silverstripe-frontend-fields": "For state dropdown field support (awaiting SS6 compatibility)"
    }
}
